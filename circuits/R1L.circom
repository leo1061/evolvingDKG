    mg.out[0] === pk[0];
    mg.out[1] === pk[1];

    // decrypt + accumulate
    signal accx[n];
    signal accy[n];
    component dec0 = ElGamalDecrypt();
    dec0.ephemeralKey     <== cipher[0][0];
    dec0.encryptedMessage <== cipher[0][1];
    dec0.privateKey       <== sk;
    accx[0] <== dec0.message[0];
    accy[0] <== dec0.message[1];

    component dec1 = ElGamalDecrypt();
    dec1.ephemeralKey     <== cipher[1][0];
    dec1.encryptedMessage <== cipher[1][1];
    dec1.privateKey       <== sk;
    component add1 = BabyAdd();
    add1.x1 <== accx[0];
    add1.y1 <== accy[0];
    add1.x2 <== dec1.message[0];
    add1.y2 <== dec1.message[1];
    accx[1] <== add1.xout;
    accy[1] <== add1.yout;

    component dec2 = ElGamalDecrypt();
    dec2.ephemeralKey     <== cipher[2][0];
    dec2.encryptedMessage <== cipher[2][1];
    dec2.privateKey       <== sk;
    component add2 = BabyAdd();
    add2.x1 <== accx[1];
    add2.y1 <== accy[1];
    add2.x2 <== dec2.message[0];
    add2.y2 <== dec2.message[1];
    accx[2] <== add2.xout;
    accy[2] <== add2.yout;

    component dec3 = ElGamalDecrypt();
    dec3.ephemeralKey     <== cipher[3][0];
    dec3.encryptedMessage <== cipher[3][1];
    dec3.privateKey       <== sk;
    component add3 = BabyAdd();
    add3.x1 <== accx[2];
    add3.y1 <== accy[2];
    add3.x2 <== dec3.message[0];
    add3.y2 <== dec3.message[1];
    accx[3] <== add3.xout;
    accy[3] <== add3.yout;
// confronto finale
    accx[n-1] === Y[0];
    accy[n-1] === Y[1];
}

component main = R1L(4);
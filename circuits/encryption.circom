pragma circom 2.2.2;

include "../circomlib/circuits/babyjub.circom";
include "../circomlib/circuits/bitify.circom";
include "../circomlib/circuits/escalarmulany.circom";
include "../circomlib/circuits/escalarmulfix.circom";
include "../circomlib/circuits/comparators.circom";

template ElGamalEncrypt() {
    // message encoded as a point on the curve: message = [plaintext].G, G: curve base point
    signal input message[2];    
    // secret key nonce (should be random and within field range)          
    signal input nonceKey;    
    // public key generated by the receiver             
    signal input publicKey[2];             

    // ephemeral key: [nonce].Base
    signal output ephemeralKey[2];  
    // encrypted message: encryptedMessage = message + [nonceKey].publicKey           
    signal output encryptedMessage[2];            
    
    // Convert nonceKey to bits for scalar multiplication
    component nonceNum = Num2Bits(250);
    nonceNum.in <== nonceKey;  // Fixed: use <== for input assignment
    
    // Validate public key is not the identity point (0,1)
    component isZeroX = IsZero();
    isZeroX.in <== publicKey[0];
    
    component isOneY = IsEqual();
    isOneY.in[0] <== publicKey[1];
    isOneY.in[1] <== 1;

    // Ensure public key is not the identity point (protects against invalid curve attacks)
    component isIdentity = IsEqual();
    isIdentity.in[0] <== isZeroX.out + isOneY.out;
    isIdentity.in[1] <== 2;
    isIdentity.out === 0;  // Should not be identity point

    // Validate the public key is a point on the curve
    component isOnCurvePub = BabyCheck();             
    isOnCurvePub.x <== publicKey[0];
    isOnCurvePub.y <== publicKey[1];
 
    // Validate the message is a point on the curve
    component isOnCurveMsg = BabyCheck();             
    isOnCurveMsg.x <== message[0];
    isOnCurveMsg.y <== message[1];
    
    // Baby Jubjub curve base point (generator)
    var base[2] = [
        5299619240641551281634865583518297030282874472190772894086521144482721001553,
        16950150798460657717958625567821834550301663161624707787222815936182638968203
    ];        

    // Calculate the ephemeral key: [nonceKey] * Base
    component ephemeralKeyCalc = EscalarMulFix(250, base);
    for (var i = 0; i < 250; i++) {
        ephemeralKeyCalc.e[i] <== nonceNum.out[i];
    }
    ephemeralKey[0] <== ephemeralKeyCalc.out[0];
    ephemeralKey[1] <== ephemeralKeyCalc.out[1];
    
    // Calculate the shared secret: [nonceKey] * publicKey
    component sharedSecret = EscalarMulAny(250);
    sharedSecret.p[0] <== publicKey[0];
    sharedSecret.p[1] <== publicKey[1];
    for (var j = 0; j < 250; j++) {
        sharedSecret.e[j] <== nonceNum.out[j];
    }

    // Calculate encrypted message: message + sharedSecret
    component addPoints = BabyAdd();
    addPoints.x1 <== message[0];
    addPoints.y1 <== message[1];
    addPoints.x2 <== sharedSecret.out[0];
    addPoints.y2 <== sharedSecret.out[1];
    
    encryptedMessage[0] <== addPoints.xout;
    encryptedMessage[1] <== addPoints.yout;
}


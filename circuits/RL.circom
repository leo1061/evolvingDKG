    mulG.e[249] <== bits.out[249];
    mulG.e[250] <== bits.out[250];
    mulG.e[251] <== bits.out[251];
    mulG.out[0] === Y[0];
    mulG.out[1] === Y[1];

    // 2) Polinomio
    { var acc = coeffs[0];
      acc += coeffs[1] * 0;
      acc += coeffs[2] * 0;
      x[0] === acc;
    }
    { var acc = coeffs[0];
      acc += coeffs[1] * 1;
      acc += coeffs[2] * 1;
      x[1] === acc;
    }
    { var acc = coeffs[0];
      acc += coeffs[1] * 2;
      acc += coeffs[2] * 4;
      x[2] === acc;
    }
    // 3) ElGamalEncrypt su msg/cipher
    component enc0 = ElGamalEncrypt();
    enc0.message[0]       <== msg[0][0];
    enc0.message[1]       <== msg[0][1];
    enc0.nonceKey         <== sk[0];
    enc0.publicKey[0]     <== pk[0][0];
    enc0.publicKey[1]     <== pk[0][1];
    enc0.ephemeralKey[0]  === cipher[0][0][0];
    enc0.ephemeralKey[1]  === cipher[0][0][1];
    enc0.encryptedMessage[0] === cipher[0][1][0];
    enc0.encryptedMessage[1] === cipher[0][1][1];

    component enc1 = ElGamalEncrypt();
    enc1.message[0]       <== msg[1][0];
    enc1.message[1]       <== msg[1][1];
    enc1.nonceKey         <== sk[1];
    enc1.publicKey[0]     <== pk[1][0];
    enc1.publicKey[1]     <== pk[1][1];
    enc1.ephemeralKey[0]  === cipher[1][0][0];
    enc1.ephemeralKey[1]  === cipher[1][0][1];
    enc1.encryptedMessage[0] === cipher[1][1][0];
    enc1.encryptedMessage[1] === cipher[1][1][1];

}
component main = RL();
